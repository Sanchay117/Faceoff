# Faceoff — environment
#
# Copy to .env.local and fill in.

# A Shannon-testnet key holding STT, used ONLY to drip gas to new burner wallets.
# Generate one with:  node -e "console.log(require('viem/accounts').generatePrivateKey())"
# Then fund its address at https://testnet.somnia.network
TREASURY_PRIVATE_KEY=0x

# Optional. The event-contract venue to scope to. Defaults to the production
# Shannon venue; override only if the venue rolls.
# NEXT_PUBLIC_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
